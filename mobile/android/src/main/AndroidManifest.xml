<?xml version="1.0" encoding="utf-8"?>
<!--
  Radius Android manifest.

  !! UNVERIFIED !! Never merged or built (no JDK, blocker B5).

  THE PERMISSION SET IS A PRODUCT SURFACE, NOT PLUMBING. Every line below is deliberate. A dating
  app asking for location is a trust event and a Play-review event, so the rule here is: ask for
  the narrowest thing that works, cap it by API level, and be able to justify it in one sentence.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      API 31+ (Android 12 and up). The modern, non-location Bluetooth permissions.

      neverForLocation is the important one. It is a formal, Play-visible assertion that we do not
      derive physical location from BLE scan results. It is TRUE for Radius by construction:
      safety invariant 1 forbids maps, bearing and lat/lng anywhere in the product, and invariant 2
      reduces signal strength to four coarse bands before it reaches any UI. This flag also means
      the OS does not require the user to grant location for scanning at all on 12+ — which is
      exactly the outcome we want.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Broadcasting our rotating ephemeral id. Peripheral role. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!--
      GATT connections, and ONLY after a mutual wave (40-contracts BLE wire v0). We do not open a
      connection to discover anyone; discovery is advertisement-only.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Legacy, API 29-30 only. Capped so they vanish on modern devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!--
      ACCESS_FINE_LOCATION, capped at API 30. JUSTIFY THIS IN EVERY PR THAT TOUCHES IT.

      Why it is genuinely required: on Android 10 and 11 there is no BLUETOOTH_SCAN permission, and
      a BLE scan without FINE location returns ZERO results SILENTLY — no exception, no callback,
      no error. Radar simply finds nobody. COARSE is not sufficient; Android 10 tightened that.

      Why it is capped at 30: from Android 12 onward BLUETOOTH_SCAN + neverForLocation replaces it
      entirely, so the great majority of users will never see a location prompt from Radius.

      Why there is no ACCESS_BACKGROUND_LOCATION: we do not want it, we do not need it, and asking
      would be indefensible for a product that stores no coordinates. If anyone proposes adding it,
      that is a safety-invariant conversation, not a build fix.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Radar runs as a foreground service so the user always knows the radio is on. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <!--
      API 33+. Needed for the Radar foreground-service notification to be visible. If denied, the
      service still runs but the notification is suppressed — the user then has a radio running
      they cannot see, so the UI must handle refusal honestly rather than nagging.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!--
      Hard requirement. A device without BLE cannot do the one thing that makes this product
      different. Better to be invisible on the store for those devices than to ship a broken half.
    -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!--
      DELIBERATELY ABSENT and must stay absent:
        ACCESS_BACKGROUND_LOCATION · ACCESS_COARSE_LOCATION · READ_CONTACTS · READ_PHONE_STATE ·
        READ_PHONE_NUMBERS (calling invariant C1: phone numbers are never exchanged) ·
        RECORD_AUDIO for anything other than an active WebRTC call (invariant C2: never recorded)

      ALSO ABSENT, AND LOAD-BEARING: the network permission. Nothing in this app, in either build
      variant, may open a socket. That is the enforcement of 40-contracts P1 — an observed
      ephemeral_id must never reach a server on any endpoint, including diagnostics — and it is
      what makes the Phase 0 spike harness's `adb pull` the only egress that exists. It will have
      to be granted eventually for the API client; when it is, P1 becomes a code-review rule
      instead of a structural impossibility, and that transition deserves its own conversation.

      ALSO ABSENT AS OF 2026-08-04, and this one had to be removed rather than merely not added:
      WAKE_LOCK, ACCESS_NETWORK_STATE and RECEIVE_BOOT_COMPLETED. Nobody typed them — androidx.work
      merged them in, for a WorkManager dependency that was declared and never called. The
      dependency is now gone (see the block in mobile/android/build.gradle.kts) and all three
      permissions are gone with it, verified against build/intermediates/packaged_manifests/ for
      BOTH variants before and after.

      The general lesson, worth more than the specific fix: A PERMISSION AUDIT MUST READ THE MERGED
      MANIFEST, NOT THIS FILE. A source-only review of this file would have declared the permission
      set clean while the shipped APK asked for a background-persistence signal and a network
      permission. Whatever CI check gets written for this must run against
      build/intermediates/packaged_manifests/*/*/AndroidManifest.xml.
    -->

    <application
        android:name=".RadiusApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Radius">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|fontScale"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Radius">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          connectedDevice is the correct FGS type for BLE proximity. It is not "location" — using
          the location FGS type would contradict neverForLocation above and would be a lie.
        -->
        <service
            android:name=".radar.RadarForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />

    </application>

</manifest>
