<?xml version="1.0" encoding="utf-8"?>
<!--
  All user-visible copy lives here, never inline in Compose. Two reasons: translation, and the
  fact that safety copy gets reviewed and must be findable in one place.

  COPY RULES for this product:
   - never promise continuous background discovery (standing risk R1). Hedge honestly.
   - distance is always hedged. "about", "roughly". Never a precise metre count, because the
     number shown is a band midpoint plus jitter, not a measurement (safety invariant 2).
   - no manufactured urgency, no countdowns, no "someone viewed you". All banned.
-->
<resources>
    <string name="app_name">Radius</string>

    <!-- navigation -->
    <string name="tab_discover">Discover</string>
    <string name="tab_radar">Radar</string>
