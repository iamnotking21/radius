  "property_assertions": [
    { "name": "stable-within-epoch",
      "note": "ephemeral_id is constant for the whole 15-minute epoch",
      "equal_ephemeral_id": ["ak1-20260804-000000", "ak1-20260804-001459"] },
    { "name": "rotates-at-epoch-boundary",
      "note": "one second later, across the :15 boundary, the id changes",
      "differ_ephemeral_id": ["ak1-20260804-001459", "ak1-20260804-001500"] },
    { "name": "stable-across-last-epoch",
      "equal_ephemeral_id": ["ak1-20260804-234500", "ak1-20260804-235959"] },
    { "name": "rotates-at-day-boundary",
      "note": "day rollover changes daily_key, therefore the id, even though epoch_index is 0 in both",
      "differ_daily_key": ["ak1-20260804-000000", "ak1-20260805-000000"],
      "differ_ephemeral_id": ["ak1-20260804-000000", "ak1-20260805-000000"] },
    { "name": "distinct-accounts-distinct-ids",
      "note": "same instant, different account_key",
      "differ_ephemeral_id": ["ak1-20260804-000000", "ak2-20260804-000000", "ak3-20260804-000000"] }
  ],
  "invalid": [
    { "name": "epoch-index-96-impossible", "epoch_index": 96,
      "expect_error": "E_EPOCH_INDEX_OUT_OF_RANGE",
      "note": "epoch index is UTC-day-relative, 0..95. 96 means a clock bug. MUST fault, MUST NOT clamp." },
    { "name": "epoch-index-negative", "epoch_index": -1,
      "expect_error": "E_EPOCH_INDEX_OUT_OF_RANGE" },
    { "name": "account-key-wrong-length", "account_key_hex": "000102030405060708090a0b0c0d0e0f",
      "expect_error": "E_ACCOUNT_KEY_LENGTH",
      "note": "account_key is exactly 32 bytes" }
  ]
